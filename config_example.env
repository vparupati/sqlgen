# LLM Server Configuration
# Configure the LLM server connection for the Gen-SQL application

# ========================================
# Ollama (Recommended for Mac)
# ========================================
# Default configuration - runs on port 11434
# Installation: https://ollama.ai
# Usage: ollama serve
#        ollama pull llama2 (or your preferred model)
LLM_HOST=localhost
LLM_PORT=11434
# LLM_MODEL=llama2  # Optional: specify model name

# ========================================
# LM Studio
# ========================================
# Runs on port 1234 by default
# Download from: https://lmstudio.ai
# Start local server from the UI
# LLM_PORT=1234

# ========================================
# llama-cpp-python
# ========================================
# Runs on port 8080 by default
# Installation: pip install llama-cpp-python[server]
# Usage: python -m llama_cpp.server --model path/to/model.gguf
# LLM_PORT=8080

# ========================================
# Advanced Configuration
# ========================================
# For remote servers, specify the host:
# LLM_HOST=192.168.1.100

# To use a specific model (overrides auto-selection):
# LLM_MODEL=llama2:13b
